{
  "appId": "electron-spark-demo",
  "productName": "Electron Spark",
  "asar": true,
  "directories": {
    "output": "release/${version}"
  },
  "files": ["dist/**/*", "!**/*.map", "!**/*.{ts,tsx,cts,mts}", "!**/.env*"],
  "mac": {
    "icon": "src/resources/icons/macos/icon.icns",
    "artifactName": "${productName}_${version}.${ext}",
    "target": ["dmg", "zip"],
    "notarize": true,
    "hardenedRuntime": true
  },
  "win": {
    "icon": "src/resources/icons/windows/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}_${version}.${ext}"
  },
  "linux": {
    "icon": "src/resources/icons/linux/icons"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "forceCodeSigning": true,
  "publish": null,
  "beforePack": "./scripts/release-hooks.ts",
  "afterPack": "./scripts/release-hooks.ts",
  "afterSign": "./scripts/release-hooks.ts",
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true,
    "enableCookieEncryption": true
  },
  "dmg": {
    "sign": true
  },
  "afterAllArtifactBuild": "./scripts/release-hooks.ts"
}
