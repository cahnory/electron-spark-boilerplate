{
  "name": "@electron-spark/demo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "François Germain (Cahnory)",
    "email": "cahnory@gmail.com",
    "url": "https://github.com/cahnory"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cahnory/electron-spark-boilerplate.git"
  },
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "pnpm check && pnpm build:dist && electron-builder --publish never",
    "build:dist": "vite build",
    "build:local": "pnpm check && pnpm build:dist && electron-builder --config electron-builder.local.json --dir --publish never",
    "check": "concurrently --group pnpm:check:format pnpm:check:lint pnpm:check:test pnpm:check:types pnpm:check:unused",
    "check:format": "oxfmt --check .",
    "check:lint": "oxlint --deny-warnings .",
    "check:test": "node --experimental-test-module-mocks --test --test-reporter=./scripts/test-reporter.ts tests/*.test.ts",
    "check:types": "concurrently --group \"tsc --noEmit -p tsconfig.main.json\" \"tsc --noEmit -p tsconfig.preload.json\" \"tsc --noEmit -p tsconfig.view.json\" \"tsc --noEmit -p tsconfig.workspace.json\"",
    "check:unused": "knip",
    "dev": "pnpm vite dev",
    "fix": "concurrently -m 1 --group pnpm:fix:unused pnpm:fix:lint pnpm:fix:format",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "fix:unused": "knip --fix"
  },
  "dependencies": {
    "@electron-spark/ipc": "^0.1.0",
    "@electron-spark/store": "^0.1.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@vanilla-extract/css": "^1.21.3",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intl": "^12.1.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-spark/electron-builder-verification": "^0.3.0",
    "@electron-spark/vite-config": "^0.2.0",
    "@electron-spark/vite-plugin-electron-app-identity": "^0.2.1",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint-plugin-formatjs": "^8.1.3",
    "knip": "^6.44.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.1.0-dev.20261102.1",
    "vite": "^8.3.5"
  }
}
